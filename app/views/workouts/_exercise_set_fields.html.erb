<% set_number_value = set_form.object.set_number.presence || (set_form.index.to_s.match?(/\A\d+\z/) ? set_form.index.to_i + 1 : nil) %>
<div class="grid gap-3 rounded-2xl border border-white/10 bg-black/30 p-3 sm:grid-cols-12" data-exercise-entries-target="setRow">
  <%= set_form.hidden_field :id if set_form.object.persisted? %>
  <%= set_form.hidden_field :set_number, value: set_number_value %>
  <%= set_form.hidden_field :_destroy, value: "0" %>
  <div class="flex items-center sm:col-span-2">
    <p class="text-sm font-black text-zinc-400">
      Set <span data-exercise-entries-target="setLabel"><%= set_number_value || "?" %></span>
    </p>
  </div>
  <div class="sm:col-span-4">
    <%= set_form.label :weight, "Weight", class: "block text-xs font-bold uppercase tracking-[0.14em] text-zinc-500" %>
    <%= set_form.number_field :weight,
      min: 0,
      step: "0.5",
      placeholder: "145",
      class: "mt-1 block w-full rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100 shadow-sm outline-none transition focus:border-amber-400/50 focus:ring-2 focus:ring-amber-400/20" %>
  </div>
  <div class="sm:col-span-4">
    <%= set_form.label :reps, "Reps", class: "block text-xs font-bold uppercase tracking-[0.14em] text-zinc-500" %>
    <%= set_form.number_field :reps,
      min: 1,
      placeholder: "8",
      class: "mt-1 block w-full rounded-xl border border-white/10 bg-zinc-950 px-4 py-3 text-zinc-100 shadow-sm outline-none transition focus:border-amber-400/50 focus:ring-2 focus:ring-amber-400/20" %>
  </div>
  <div class="flex items-end sm:col-span-2">
    <button type="button"
      class="w-full rounded-xl border border-white/10 px-3 py-3 text-xs font-bold text-zinc-400 transition hover:bg-white/10 hover:text-white"
      data-action="exercise-entries#removeSet">
      Remove
    </button>
  </div>
</div>